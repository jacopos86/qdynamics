# H2O single point calculation
# lines starting with '#' are comments

method  = RHF
basis   = sto-3g
charge  = 0
spin    = 0          # 2S, number of unpaired electrons
unit    = Angstrom

output  = results/h2o
# write_h5      = true       # optional, default true
# write_fcidump = true       # optional, default true
# fcidump_tol   = 1e-12      # optional

geometry
  O   0.0000   0.0000   0.1173
  H   0.0000   0.7572  -0.4692
  H   0.0000  -0.7572  -0.4692
end
