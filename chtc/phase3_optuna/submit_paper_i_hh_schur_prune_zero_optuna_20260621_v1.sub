# Six-regime Paper-I HH SNAKE Schur-prune Optuna batch.
# Objective surface: hard zero prune rollback/rejection gate, then energy,
# shot work, and graph/depth cost. Target-hit stopping remains disabled:
# the task wrapper does not pass --adapt-benchmark-target-abs-delta-e to ADAPT.
universe = vanilla
executable = chtc/phase3_optuna/run_paper_i_hh_speed_optuna_apptainer.sh
arguments = $(regime) $(tag) raw_outputs/paper_i_hh_schur_prune_zero_optuna_20260621_v1/$(tag) 12 search 30 800 800 prune_zero_then_energy_shot_graph_cost staged_shot 8 8 8 8 8 $(target_abs_delta_e) true output/pdf/paper_i_hh_shot_focus_candidate_priors_from_overlay_20260616.json
should_transfer_files = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_executable = True
preserve_relative_paths = True
transfer_input_files = pipelines, src, docs, test_support, MATH/paper_facing/paper_I_static_scaffold/hh_ed_reference_manifest_20260614.json, MATH/paper_facing/paper_I_static_scaffold/paper_i_hh_geo_targets_20260615.json, agent_guidance/static-adapt/hh_full_meta_minus_hva_class_filter.json, output/pdf/paper_i_hh_shot_focus_candidate_priors_from_overlay_20260616.json, chtc/phase3_optuna
transfer_output_files = raw_outputs, logs
log = logs/paper_i_hh_schur_prune_zero_optuna_20260621_v1.$(Cluster).$(Process).log
output = logs/paper_i_hh_schur_prune_zero_optuna_20260621_v1.$(Cluster).$(Process).out
error = logs/paper_i_hh_schur_prune_zero_optuna_20260621_v1.$(Cluster).$(Process).err
stream_output = False
stream_error = False
requirements = TARGET.HasSIF
request_cpus = 8
request_memory = 48GB
request_disk = 122880MB
+MaxRuntime = 172800
+JobBatchName = "holstein-paper_i_hh_schur_prune_zero_optuna_20260621_v1"
queue regime, target_abs_delta_e, tag from (
weak-weak 0.0004729364909101053 paper_i_hh_weak_weak_schur_prune_zero_optuna_20260621_v1
intermediate-weak 0.000225827598736078 paper_i_hh_intermediate_weak_schur_prune_zero_optuna_20260621_v1
strong-weak-u8 0.00015929638406875774 paper_i_hh_strong_weak_u8_schur_prune_zero_optuna_20260621_v1
weak-strong 0.04156061151776658 paper_i_hh_weak_strong_schur_prune_zero_optuna_20260621_v1
intermediate-strong 0.008264247636996442 paper_i_hh_intermediate_strong_schur_prune_zero_optuna_20260621_v1
