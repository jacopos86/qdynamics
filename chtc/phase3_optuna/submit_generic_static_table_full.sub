universe = vanilla
executable = chtc/phase3_optuna/run_generic_static_table_task_apptainer.sh
arguments = $(record_id)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_executable = True
preserve_relative_paths = True
transfer_input_files = pipelines, src, docs, test_support, chtc/phase3_optuna
transfer_output_files = raw_outputs, logs
log = logs/generic-static-table-full.$(Cluster).$(Process).log
output = logs/generic-static-table-full.$(Cluster).$(Process).out
error = logs/generic-static-table-full.$(Cluster).$(Process).err
requirements = TARGET.HasSIF
request_cpus = 1
request_memory = 16GB
request_disk = 122880MB
+MaxRuntime = 43200
+JobBatchName = "holstein-generic-static-table-full"
environment = "GENERIC_STATIC_TABLE_RECORDS_PATH=chtc/phase3_optuna/input/generic_static_table_records.tsv"
queue record_id from chtc/phase3_optuna/input/generic_static_table_record_ids.txt
