universe = vanilla
executable = chtc/phase3_optuna/run_static_hh_paper_task_apptainer.sh
arguments = $(record_id)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_executable = True
preserve_relative_paths = True
transfer_input_files = pipelines, src, docs, test_support, chtc/phase3_optuna
transfer_output_files = raw_outputs, logs
log = logs/static-hh-paper-l2.$(Cluster).$(Process).log
output = logs/static-hh-paper-l2.$(Cluster).$(Process).out
error = logs/static-hh-paper-l2.$(Cluster).$(Process).err
requirements = TARGET.HasSIF
request_cpus = 1
request_memory = 16GB
request_disk = 122880MB
+MaxRuntime = 43200
+JobBatchName = "holstein-static-hh-paper-l2-marrakesh"
environment = "STATIC_HH_PAPER_RECORDS_PATH=chtc/phase3_optuna/input/static_hh_paper_l2_records.tsv"
queue record_id from chtc/phase3_optuna/input/static_hh_paper_l2_record_ids.txt
