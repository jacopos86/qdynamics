# Lighter candidate Optuna batch for all Paper-I HH SNAKE regimes.
# Replaces the too-heavy v1 trial shape; keeps all six regimes but lowers per-trial optimizer load.
# Search pass only: rerun/refit winning ansaetze with larger SPSA budget after candidates are identified.
universe = vanilla
executable = chtc/phase3_optuna/run_paper_i_hh_speed_optuna_apptainer.sh
arguments = $(regime) $(tag) raw_outputs/paper_i_hh_all_regimes_light_graphshot_optuna_20260615_v2/$(tag) 12 search 10 120 120 graph_cost_speed_feasible staged_graph 6 8 8 8 8
should_transfer_files = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_executable = True
preserve_relative_paths = True
transfer_input_files = pipelines, src, docs, test_support, MATH/paper_facing/paper_I_static_scaffold/hh_ed_reference_manifest_20260614.json, agent_guidance/static-adapt/hh_full_meta_minus_hva_class_filter.json, chtc/phase3_optuna
transfer_output_files = raw_outputs, logs
log = logs/paper_i_hh_all_regimes_light_graphshot_optuna_20260615_v2.$(Cluster).$(Process).log
output = logs/paper_i_hh_all_regimes_light_graphshot_optuna_20260615_v2.$(Cluster).$(Process).out
error = logs/paper_i_hh_all_regimes_light_graphshot_optuna_20260615_v2.$(Cluster).$(Process).err
stream_output = False
stream_error = False
requirements = TARGET.HasSIF
request_cpus = 8
request_memory = 32GB
request_disk = 81920MB
+MaxRuntime = 86400
+JobBatchName = "holstein-paper_i_hh_all_regimes_light_graphshot_optuna_20260615_v2"
queue regime, tag from (
weak-weak paper_i_hh_weak_weak_light_graphshot_optuna_20260615_v2
intermediate-weak paper_i_hh_intermediate_weak_light_graphshot_optuna_20260615_v2
strong-weak-u8 paper_i_hh_strong_weak_u8_light_graphshot_optuna_20260615_v2
weak-strong paper_i_hh_weak_strong_light_graphshot_optuna_20260615_v2
intermediate-strong paper_i_hh_intermediate_strong_light_graphshot_optuna_20260615_v2
strong-strong-u8 paper_i_hh_strong_strong_u8_light_graphshot_optuna_20260615_v2
)
