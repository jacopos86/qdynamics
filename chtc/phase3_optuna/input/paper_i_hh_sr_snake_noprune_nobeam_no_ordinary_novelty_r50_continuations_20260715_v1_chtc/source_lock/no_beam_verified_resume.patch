+def _load_verified_singleton_estimator_ledger(
+    source: ResumeScaffoldSource,
+) -> tuple[dict[str, Any], dict[str, Any]]:
+    path = source.artifact_json.with_name("estimator_call_ledger.json")
+    if not path.is_file():
+        raise ValueError("Verified singleton resume requires estimator_call_ledger.json.")
+    sidecar = _read_json_object(path)
+    accounting = sidecar.get("accounting", {})
+    ledger_raw = sidecar.get("ledger", {})
+    if (
+        sidecar.get("schema") != "paper_i_estimator_call_ledger_sidecar_v1"
+        or sidecar.get("adapt_success") is not True
+        or sidecar.get("adapt_error") not in {None, ""}
+        or not isinstance(accounting, Mapping)
+        or accounting.get("enabled") is not True
+        or accounting.get("complete") is not True
+        or list(accounting.get("exact_blockers", []))
+        or not isinstance(ledger_raw, Mapping)
+    ):
+        raise ValueError("Verified singleton estimator-ledger sidecar is unresolved.")
+    full = EstimatorCallLedger.from_payload(ledger_raw)
+    full_payload = full.to_payload()
+    identities: dict[str, EstimatorCallKey] = {}
+    for entry in full_payload.get("entries", []):
+        if not isinstance(entry, Mapping) or not isinstance(entry.get("identity"), Mapping):
+            raise ValueError("Verified singleton estimator-ledger entry is invalid.")
+        key = EstimatorCallKey.from_dict(entry["identity"])
+        primitive_id = str(entry.get("primitive_id", ""))
+        if primitive_id != key.primitive_id or primitive_id in identities:
+            raise ValueError("Verified singleton estimator-ledger identity is invalid.")
+        identities[primitive_id] = key
+    occurrences = full_payload.get("occurrences", [])
+    if not isinstance(occurrences, list) or not occurrences:
+        raise ValueError("Verified singleton estimator-ledger occurrences are missing.")
+    terminal_index = next(
+        (
+            i for i, row in enumerate(occurrences)
+            if isinstance(row, Mapping)
+            and str(row.get("consumer_scope", "")) in _TERMINAL_ESTIMATOR_CONSUMER_SCOPES
+        ),
+        None,
+    )
+    prefix_rows = occurrences if terminal_index is None else occurrences[:terminal_index]
+    terminal_rows = [] if terminal_index is None else occurrences[terminal_index:]
+    if not prefix_rows or any(
+        not isinstance(row, Mapping)
+        or str(row.get("consumer_scope", "")) not in _TERMINAL_ESTIMATOR_CONSUMER_SCOPES
+        for row in terminal_rows
+    ):
+        raise ValueError("Verified singleton estimator-ledger terminal suffix is invalid.")
+    prefix = EstimatorCallLedger()
+    for sequence, row in enumerate(prefix_rows, start=1):
+        if not isinstance(row, Mapping) or int(row.get("sequence", 0)) != sequence:
+            raise ValueError("Verified singleton estimator-ledger sequence is invalid.")
+        key = identities.get(str(row.get("primitive_id", "")))
+        if key is None:
+            raise ValueError("Verified singleton estimator-ledger identity is missing.")
+        receipt = prefix.record_call(
+            key,
+            component=str(row.get("component", "")),
+            consumer_scope=str(row.get("consumer_scope", "")),
+            branch_id=None if row.get("branch_id") is None else str(row.get("branch_id")),
+        )
+        if bool(receipt.charged) != bool(row.get("charged", False)):
+            raise ValueError("Verified singleton estimator-ledger charge replay failed.")
+    full_summary = full.summary()
+    prefix_summary = prefix.summary()
+    all_work = accounting.get("all_branch_search_work", {})
+    if not isinstance(all_work, Mapping) or int(all_work.get("S_alg", -1)) != int(full_summary["S_alg"]):
+        raise ValueError("Verified singleton estimator-ledger accounting does not close.")
+    prefix_payload = prefix.to_payload()
+    return prefix_payload, {
+        "schema_version": "static_adapt_verified_singleton_estimator_ledger_v1",
+        "path": str(path),
+        "sha256": file_sha256(path),
+        "full_ledger_fingerprint": str(full_payload["ledger_fingerprint"]),
+        "restored_prefix_ledger_fingerprint": str(prefix_payload["ledger_fingerprint"]),
+        "full_occurrence_count": len(occurrences),
+        "restored_prefix_occurrence_count": len(prefix_rows),
+        "excluded_terminal_occurrence_count": len(terminal_rows),
+        "full_S_alg": int(full_summary["S_alg"]),
+        "restored_prefix_S_alg": int(prefix_summary["S_alg"]),
+        "discarded_frontier_reconstructed": False,
+        "no_credentials_serialized": True,
+    }
