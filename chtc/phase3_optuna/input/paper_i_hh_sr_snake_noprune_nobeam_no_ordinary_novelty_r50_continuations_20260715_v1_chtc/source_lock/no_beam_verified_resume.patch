+def _load_verified_active_prefix_sidecar(
+    source: ResumeScaffoldSource,
+) -> dict[str, Any]:
+    path = source.artifact_json.with_name("signed_active_prefix_checkpoint.json")
+    if not path.is_file():
+        raise ValueError(
+            "Verified no-refit resume requires sibling "
+            "signed_active_prefix_checkpoint.json."
+        )
+    wrapper = _read_json_object(path)
+    if wrapper.get("schema") != "static_adapt_signed_active_prefix_resume_sidecar_v1":
+        raise ValueError("Signed-prefix resume sidecar schema is unsupported.")
+    source_result = wrapper.get("source_result_json")
+    source_result_sha = str(wrapper.get("source_result_sha256", ""))
+    if (
+        not isinstance(source_result, str)
+        or not source_result.strip()
+        or re.fullmatch(r"[0-9a-f]{64}", source_result_sha) is None
+    ):
+        raise ValueError("Signed-prefix sidecar source-result provenance is invalid.")
+    raw = wrapper.get("checkpoint")
+    if not isinstance(raw, Mapping):
+        raise ValueError("Signed-prefix sidecar checkpoint is missing.")
+    checkpoint = dict(raw)
+    expected_sha = str(checkpoint.get("checkpoint_sha256", ""))
+    hash_input = dict(checkpoint)
+    hash_input.pop("checkpoint_sha256", None)
+    if not expected_sha or digest_jsonable(hash_input) != expected_sha:
+        raise ValueError("Signed-prefix checkpoint SHA-256 mismatch.")
+    labels = tuple(str(term.label) for term in source.runtime_input.selected_terms)
+    depth = len(labels)
+    adapt = _adapt_block(source.payload)
+    if (
+        checkpoint.get("schema") != "paper_i_signed_active_prefix_checkpoint_v1"
+        or checkpoint.get("checkpoint_kind") != "post_admission_prune"
+        or int(checkpoint.get("outer_iteration", -1)) != depth
+        or int(checkpoint.get("active_ansatz_depth", -1)) != depth
+        or tuple(str(x) for x in checkpoint.get("ordered_active_operator_labels", [])) != labels
+        or tuple(str(x) for x in adapt.get("operators", [])) != labels
+    ):
+        raise ValueError("Signed-prefix checkpoint identity disagrees with current.json.")
+    runtime_theta = np.asarray(
+        checkpoint.get("signed_unwrapped_runtime_parameters", []), dtype=float
+    ).reshape(-1)
+    logical_theta = np.asarray(
+        checkpoint.get("signed_unwrapped_logical_parameters", []), dtype=float
+    ).reshape(-1)
+    source_logical = np.asarray(source.runtime_input.theta_logical, dtype=float).reshape(-1)
+    if (
+        runtime_theta.shape != source.runtime_input.theta_runtime.shape
+        or logical_theta.shape != source_logical.shape
+        or not np.allclose(runtime_theta, source.runtime_input.theta_runtime, atol=1e-12, rtol=0.0)
+        or not np.allclose(logical_theta, source_logical, atol=1e-12, rtol=0.0)
+        or str(checkpoint.get("parameterization_execution_mode", ""))
+        != str(adapt.get("parameterization_execution_mode", ""))
+    ):
+        raise ValueError("Signed-prefix checkpoint coordinates disagree with current.json.")
+    active_sector = checkpoint.get("active_generator_sector_contract", {})
+    state_sector = checkpoint.get("state_sector_contract", {})
+    strict_replay = checkpoint.get("strict_replay", {})
+    if not (
+        isinstance(active_sector, Mapping)
+        and active_sector.get("passed_with_parameterization") is True
+        and isinstance(state_sector, Mapping)
+        and state_sector.get("passed") is True
+        and isinstance(strict_replay, Mapping)
+        and strict_replay.get("passed") is True
+    ):
+        raise ValueError("Signed-prefix checkpoint scientific audits did not pass.")
+    fingerprint = str(checkpoint.get("projective_state_fingerprint", ""))
+    if fingerprint != projective_state_fingerprint(source.runtime_input.psi_initial):
+        raise ValueError("Signed-prefix checkpoint state disagrees with current.json.")
+    rows = checkpoint.get("ordered_active_operators", [])
+    if not isinstance(rows, Sequence) or isinstance(rows, (str, bytes)) or len(rows) != depth:
+        raise ValueError("Signed-prefix ordered operator rows are incomplete.")
+    terms: list[AnsatzTerm] = []
+    contracts: list[dict[str, Any]] = []
+    for position, row in enumerate(rows):
+        if not isinstance(row, Mapping):
+            raise ValueError("Signed-prefix operator row is invalid.")
+        label = str(row.get("label", ""))
+        mode = str(row.get("execution_mode", ""))
+        if int(row.get("active_position", -1)) != position or label != labels[position]:
+            raise ValueError("Signed-prefix operator ordering is invalid.")
+        if mode not in {"grouped_exact", "termwise_product"}:
+            raise ValueError("Signed-prefix operator execution mode is invalid.")
+        serialized = row.get("serialized_terms_exyz_in_execution_order", [])
+        if not isinstance(serialized, Sequence) or isinstance(serialized, (str, bytes)) or not serialized:
+            raise ValueError("Signed-prefix operator terms are missing.")
+        poly = PauliPolynomial("JW")
+        normalized: list[dict[str, Any]] = []
+        for term in serialized:
+            if not isinstance(term, Mapping):
+                raise ValueError("Signed-prefix Pauli term is invalid.")
+            nq = int(term.get("nq", 0))
+            word = str(term.get("pauli_exyz", "")).lower()
+            real = float(term.get("coeff_re", 0.0))
+            imag = float(term.get("coeff_im", 0.0))
+            if nq <= 0 or len(word) != nq or any(c not in "exyz" for c in word) or not math.isfinite(real) or abs(imag) > 1e-14:
+                raise ValueError("Signed-prefix Pauli term is invalid.")
+            poly.add_term(PauliTerm(nq, ps=word, pc=real))
+            normalized.append({"pauli_exyz": word, "coeff_re": real, "coeff_im": imag, "nq": nq})
+        poly._reduce()
+        terms.append(AnsatzTerm(label=label, polynomial=poly, execution_mode=mode))
+        runtime_split = dict(row["runtime_split"]) if isinstance(row.get("runtime_split"), Mapping) else None
+        lineage = dict(row["route_a_child_padding_lineage"]) if isinstance(row.get("route_a_child_padding_lineage"), Mapping) else None
+        gate = runtime_split.get("symmetry_gate", {}) if isinstance(runtime_split, Mapping) else {}
+        hard_guard = bool(
+            isinstance(gate, Mapping)
+            and gate.get("hard_guard_required") is True
+            and gate.get("hard_guard_present") is True
+            and gate.get("passed") is True
+        )
+        if isinstance(runtime_split, Mapping) and runtime_split.get("recommended_execution_mode") not in {None, "", mode}:
+            raise ValueError("Signed-prefix runtime-split execution mode disagrees.")
+        if isinstance(lineage, Mapping) and lineage.get("selected_execution_mode") not in {None, "", mode}:
+            raise ValueError("Signed-prefix padding execution mode disagrees.")
+        contracts.append({
+            "schema": "resume_selected_generator_contract_v1",
+            "generator_id": row.get("generator_id"),
+            "label": label,
+            "parent_generator_id": row.get("parent_generator_id"),
+            "execution_mode": mode,
+            "symmetry_spec": {
+                "particle_number_mode": "preserving" if hard_guard else "off",
+                "spin_sector_mode": "preserving" if hard_guard else "off",
+                "hard_guard": hard_guard,
+                "source": "signed_active_prefix_checkpoint_v1",
+            },
+            "compile_metadata": {
+                "serialized_terms_exyz": normalized,
+                "runtime_terms_exyz": normalized,
+                "runtime_split": runtime_split,
+                "route_a_child_padding_lineage": lineage,
+            },
+        })
+    expected_guarded = [str(x) for x in active_sector.get("fixed_sector_guarded_generator_labels", [])]
+    observed_guarded = [str(c["label"]) for c in contracts if c["symmetry_spec"]["hard_guard"]]
+    if int(active_sector.get("fixed_sector_guarded_generator_count", -1)) != len(expected_guarded) or observed_guarded != expected_guarded:
+        raise ValueError("Signed-prefix hard-guard order/multiplicity does not close.")
+    return {
+        "terms": tuple(terms),
+        "contracts": tuple(contracts),
+        "provenance": {
+            "schema": "verified_resume_signed_active_prefix_sidecar_v1",
+            "source_result_json": source_result,
+            "source_result_sha256": source_result_sha,
+            "resume_sidecar_json": str(path),
+            "resume_sidecar_sha256": file_sha256(path),
+            "checkpoint_sha256": expected_sha,
+            "outer_iteration": depth,
+            "operator_count": depth,
+            "projective_state_fingerprint": fingerprint,
+        },
     }
 
 
+def _load_verified_singleton_controller_and_selection_state(
+    source: ResumeScaffoldSource,
+) -> dict[str, Any]:
+    """Restore exact controller hysteresis, residual, and selection counters."""
+
+    context = "Verified singleton controller resume"
+    path = source.artifact_json.with_name("signed_active_prefix_checkpoint.json")
+    if not path.is_file():
+        raise ValueError(f"{context} requires sibling signed-prefix sidecar.")
+    sidecar = _read_json_object(path)
+    if sidecar.get("schema") != "static_adapt_signed_active_prefix_resume_sidecar_v1":
+        raise ValueError(f"{context} sidecar schema is unsupported.")
+    source_result = sidecar.get("source_result_json")
+    source_result_sha = str(sidecar.get("source_result_sha256", ""))
+    if (
+        not isinstance(source_result, str)
+        or not source_result.strip()
+        or re.fullmatch(r"[0-9a-f]{64}", source_result_sha) is None
+    ):
+        raise ValueError(f"{context} lacks source-result provenance.")
+    adapt = _adapt_block(source.payload)
+    try:
+        controller_round = int(source.payload["checkpoint"]["depth"])
+        source_pool_size = int(adapt["pool_size"])
+    except (KeyError, TypeError, ValueError):
+        raise ValueError(f"{context} round/pool size is invalid.") from None
+    if controller_round <= 0 or source_pool_size <= 0:
+        raise ValueError(f"{context} round/pool size is invalid.")
+
+    snapshot_raw = sidecar.get("controller_snapshot")
+    if not isinstance(snapshot_raw, Mapping):
+        raise ValueError(f"{context} lacks controller_snapshot.")
+    snapshot = dict(snapshot_raw)
+    snapshot_sha = str(sidecar.get("controller_snapshot_sha256", ""))
+    if (
+        re.fullmatch(r"[0-9a-f]{64}", snapshot_sha) is None
+        or digest_jsonable(snapshot) != snapshot_sha
+    ):
+        raise ValueError(f"{context} controller snapshot digest mismatch.")
+    expected_fields = {str(field.name) for field in fields(PhaseControllerSnapshot)}
+    if set(snapshot) != expected_fields:
+        raise ValueError(f"{context} controller snapshot fields disagree.")
+    try:
+        typed_snapshot = PhaseControllerSnapshot(**snapshot)
+    except (TypeError, ValueError):
+        raise ValueError(f"{context} controller snapshot is not typed.") from None
+    if (
+        typed_snapshot.snapshot_version != "phase123_controller_maturity_v2"
+        or int(typed_snapshot.step_index) != controller_round - 1
+        or int(typed_snapshot.depth_local) != controller_round - 1
+        or int(typed_snapshot.depth_left) != 1
+    ):
+        raise ValueError(f"{context} snapshot is not the unique last-round state.")
+    phase_live = dict(typed_snapshot.phase_live)
+    null_streaks = dict(typed_snapshot.phase_null_streaks)
+    null_reasons = dict(typed_snapshot.phase_null_reasons)
+    if (
+        set(phase_live) != {"phase1", "phase2", "phase3"}
+        or phase_live.get("phase1") is not True
+        or set(null_streaks) != {"phase2", "phase3"}
+        or any(int(value) < 0 for value in null_streaks.values())
+        or set(null_reasons) != {"phase1", "phase2", "phase3"}
+    ):
+        raise ValueError(f"{context} phase-live hysteresis state is invalid.")
+    expected_terminal_phase = 1 + int(bool(phase_live["phase2"])) + int(
+        bool(phase_live["phase2"]) and bool(phase_live["phase3"])
+    )
+    if int(typed_snapshot.terminal_phase) != expected_terminal_phase:
+        raise ValueError(f"{context} terminal phase is inconsistent.")
+    for phase_name in ("phase1", "phase2", "phase3"):
+        if not bool(phase_live[phase_name]) and (
+            int(typed_snapshot.phase_caps.get(phase_name, -1)) != 0
+            or int(typed_snapshot.phase_shots.get(phase_name, -1)) != 0
+            or int(typed_snapshot.phase_shots_effective.get(phase_name, -1)) != 0
+        ):
+            raise ValueError(f"{context} inactive phase retains live work.")
+
+    controller_state_raw = sidecar.get("controller_state")
+    if not isinstance(controller_state_raw, Mapping):
+        raise ValueError(f"{context} lacks controller_state evidence.")
+    controller_state = dict(controller_state_raw)
+    if controller_state.get("schema") != "static_adapt_singleton_controller_resume_state_v1":
+        raise ValueError(f"{context} controller_state schema is unsupported.")
+    evidence_raw = controller_state.get("source_history_row_evidence")
+    if not isinstance(evidence_raw, Mapping):
+        raise ValueError(f"{context} lacks history-row evidence.")
+    evidence = dict(evidence_raw)
+    evidence_sha = str(controller_state.get("source_history_row_evidence_sha256", ""))
+    if (
+        re.fullmatch(r"[0-9a-f]{64}", evidence_sha) is None
+        or digest_jsonable(evidence) != evidence_sha
+    ):
+        raise ValueError(f"{context} history-row evidence digest mismatch.")
+    if evidence != {
+        "depth": controller_round,
+        "drop_policy_enabled": False,
+        "drop_plateau_hits": 0,
+        "stage_name": "core",
+        "stage_transition_reason": "stay_core",
+        "controller_snapshot_count": 1,
+        "selected_feature_row_index": 0,
+    }:
+        raise ValueError(f"{context} cannot prove residual lane stayed closed.")
+    if (
+        int(controller_state.get("controller_round", -1)) != controller_round
+        or int(controller_state.get("source_max_depth", -1)) != controller_round
+        or controller_state.get("phase1_residual_opened") is not False
+        or controller_state.get("phase1_stage_name") != "core"
+    ):
+        raise ValueError(f"{context} controller_state is inconsistent.")
+
+    selection_raw = sidecar.get("selection_state")
+    if not isinstance(selection_raw, Mapping):
+        raise ValueError(f"{context} lacks selection_state evidence.")
+    selection = dict(selection_raw)
+    if selection.get("schema") != "static_adapt_singleton_selection_count_resume_state_v1":
+        raise ValueError(f"{context} selection_state schema is unsupported.")
+    if (
+        int(selection.get("controller_round", -1)) != controller_round
+        or int(selection.get("pool_size", -1)) != source_pool_size
+        or selection.get("seq2p_logical_mode") is not False
+    ):
+        raise ValueError(f"{context} selection_state route identity disagrees.")
+    parent_raw = selection.get("ordered_parent_pool_indices")
+    if not isinstance(parent_raw, Sequence) or isinstance(parent_raw, (str, bytes)):
+        raise ValueError(f"{context} parent-index sequence is invalid.")
+    try:
+        parent_indices = tuple(int(value) for value in parent_raw)
+    except (TypeError, ValueError):
+        raise ValueError(f"{context} parent-index sequence is invalid.") from None
+    parent_sha = str(selection.get("ordered_parent_pool_indices_sha256", ""))
+    if (
+        len(parent_indices) != controller_round
+        or any(index < 0 or index >= source_pool_size for index in parent_indices)
+        or re.fullmatch(r"[0-9a-f]{64}", parent_sha) is None
+        or digest_jsonable(list(parent_indices)) != parent_sha
+    ):
+        raise ValueError(f"{context} parent-index lineage is incomplete or invalid.")
+    feature_counts = selection.get("selected_feature_row_count_per_round")
+    if (
+        not isinstance(feature_counts, Sequence)
+        or isinstance(feature_counts, (str, bytes))
+        or tuple(int(value) for value in feature_counts)
+        != tuple(1 for _ in range(controller_round))
+    ):
+        raise ValueError(f"{context} requires one selected feature row per round.")
+    logical_raw = selection.get("ordered_logical_candidate_indices")
+    if not isinstance(logical_raw, Sequence) or isinstance(logical_raw, (str, bytes)):
+        raise ValueError(f"{context} logical-index sequence is invalid.")
+    logical_indices = tuple(int(value) for value in logical_raw)
+    logical_sha = str(selection.get("ordered_logical_candidate_indices_sha256", ""))
+    if logical_indices or digest_jsonable([]) != logical_sha:
+        raise ValueError(f"{context} non-seq2p logical lineage must be empty.")
+
+    provenance = {
+        "schema": "verified_singleton_controller_and_selection_resume_state_v1",
+        "source_result_json": source_result,
+        "source_result_sha256": source_result_sha,
+        "resume_sidecar_json": str(path),
+        "resume_sidecar_sha256": file_sha256(path),
+        "controller_snapshot_sha256": snapshot_sha,
+        "source_history_row_evidence_sha256": evidence_sha,
+        "ordered_parent_pool_indices_sha256": parent_sha,
+        "ordered_logical_candidate_indices_sha256": logical_sha,
+        "controller_round": controller_round,
+        "pool_size": source_pool_size,
+        "phase1_residual_opened": False,
+        "phase1_stage_name": "core",
+        "selection_count_total": len(parent_indices),
+        "seq2p_logical_mode": False,
+        "no_credentials_serialized": True,
+    }
+    assert_no_secret_material(provenance, context=context)
+    return {
+        "phase1_residual_opened": False,
+        "phase1_stage_name": "core",
+        "controller_snapshot": asdict(typed_snapshot),
+        "pool_size": source_pool_size,
+        "ordered_parent_pool_indices": parent_indices,
+        "ordered_logical_candidate_indices": logical_indices,
+        "provenance": provenance,
+    }
