+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+import pipelines.static_adapt.adapt_pipeline as adapt_pipeline
+from pipelines.static_adapt.cli_config import (
+    _build_adapt_arg_parser,
+    _resolve_beam_capacity_policy,
+)
+from pipelines.static_adapt.sr_snake_route_profile import (
+    CANONICAL_SR_SNAKE_NO_PRUNE_SYMMETRIC_COST_BEAM_V1_EXECUTION_SETTINGS,
+    CANONICAL_SR_SNAKE_NO_PRUNE_SYMMETRIC_COST_V1_EXECUTION_SETTINGS,
+    SR_ROUTE_PROFILE_NO_PRUNE_SYMMETRIC_COST_BEAM_V1,
+    canonical_sr_snake_no_prune_symmetric_cost_beam_v1_contract,
+    canonical_sr_snake_no_prune_symmetric_cost_beam_v1_contract_sha256,
+)
+
+
+def _beam_args(*extra: str):
+    return _build_adapt_arg_parser(
+        adapt_gradient_parity_rtol=1.0e-7,
+    ).parse_args(
+        [
+            "--sr-route-profile",
+            "sr_snake_no_prune_symmetric_cost_beam_v1",
+            "--adapt-max-depth",
+            "50",
+            *extra,
+        ]
+    )
+
+
+def test_historical_beam_profile_is_exact_one_factor_main_variant() -> None:
+    main = CANONICAL_SR_SNAKE_NO_PRUNE_SYMMETRIC_COST_V1_EXECUTION_SETTINGS
+    beam = CANONICAL_SR_SNAKE_NO_PRUNE_SYMMETRIC_COST_BEAM_V1_EXECUTION_SETTINGS
+    changed = {field for field in main if main[field] != beam[field]}
+
+    assert changed == {
+        "adapt_beam_live_branches",
+        "adapt_beam_children_per_parent",
+        "adapt_beam_terminated_keep",
+        "adapt_beam_terminal_archive_mode",
+    }
+    assert beam["adapt_beam_live_branches"] == 3
+    assert beam["adapt_beam_children_per_parent"] == 2
+    assert beam["adapt_beam_terminated_keep"] == 3
+    assert beam["adapt_beam_terminal_archive_mode"] == "legacy"
+    assert beam["adapt_beam_lambda"] == pytest.approx(0.005)
+    assert beam["phase1_prune_enabled"] is False
+    assert beam["phase2_enable_batching"] is False
+    assert beam["phase3_enable_batching"] is False
+
+
+def test_historical_beam_profile_materializes_explicit_3x2_policy() -> None:
+    args = _beam_args()
+    assert args.sr_route_profile_resolved == (
+        SR_ROUTE_PROFILE_NO_PRUNE_SYMMETRIC_COST_BEAM_V1
+    )
+    assert args.adapt_max_depth == 50
+    assert args.adapt_beam_live_branches == 3
+    assert args.adapt_beam_children_per_parent == 2
+    assert args.adapt_beam_terminated_keep == 3
+    assert args.adapt_beam_terminal_archive_mode == "legacy"
+    assert args.adapt_beam_lambda == pytest.approx(0.005)
+
+    policy = _resolve_beam_capacity_policy(
+        adapt_beam_live_branches=args.adapt_beam_live_branches,
+        adapt_beam_children_per_parent=args.adapt_beam_children_per_parent,
+        adapt_beam_terminated_keep=args.adapt_beam_terminated_keep,
+        adapt_beam_terminal_archive_mode=args.adapt_beam_terminal_archive_mode,
+    )
+    assert policy.beam_enabled is True
+    assert policy.live_branches_effective == 3
+    assert policy.children_per_parent_effective == 2
+    assert policy.terminated_keep_effective == 3
+    assert policy.source_terminated_keep == "legacy_explicit"
+
+
+def test_historical_beam_contract_names_exact_archive_semantics() -> None:
+    contract = canonical_sr_snake_no_prune_symmetric_cost_beam_v1_contract()
+    invariants = contract["semantic_invariants"]
+
+    assert contract["route_profile"] == (
+        SR_ROUTE_PROFILE_NO_PRUNE_SYMMETRIC_COST_BEAM_V1
+    )
+    assert len(canonical_sr_snake_no_prune_symmetric_cost_beam_v1_contract_sha256()) == 64
+    assert invariants["beam_live_branch_cap"] == 3
+    assert invariants["beam_children_per_parent"] == 2
+    assert invariants["beam_expanded_child_cap_per_round"] == 6
+    assert invariants["beam_parent_stop_terminal_also_materialized"] is True
+    assert invariants["beam_structural_mode"] == "stop_or_single_admission"
+    assert invariants["beam_terminal_archive_accumulation"] == (
+        "cumulative_across_rounds"
+    )
+    assert invariants["beam_terminal_archive_cap"] == 3
+
+
+def test_legacy_archive_execution_keeps_historical_stop_or_admit_structure() -> None:
+    source = Path(adapt_pipeline.__file__).read_text(encoding="utf-8")
+    enabled = source.index("beam_terminal_archive_enabled = bool(")
+    parent_stop = source.index(
+        "if bool(beam_terminal_archive_enabled):\n"
+        "                        # Exact pre-2026-07-04 historical semantics",
+        enabled,
+    )
+    stop_gate = source.index(
+        "if scratch.stop_reason is not None or not scratch.proposals:",
+        parent_stop,
+    )
+    selected = source.index("selected_plans = list(scratch.proposals)", stop_gate)
+    accumulation = source.index("[*terminals, *round_terminals]", selected)
+    cap = source.index('source="round_terminal_archive"', accumulation)
+
+    assert enabled < parent_stop < stop_gate < selected < accumulation < cap
+    assert '"stop_or_single_admission"' in source
+    assert '"beam_parent_stop_terminal_also_materialized": bool(' in source
+    assert '"materialize_parent_stop_and_accumulate_capped_v1"' in source
+
+
+@pytest.mark.parametrize(
+    "override",
+    [
+        ("--adapt-beam-live-branches", "2"),
+        ("--adapt-beam-children-per-parent", "3"),
+        ("--adapt-beam-terminated-keep", "0"),
+        ("--adapt-beam-terminal-archive-mode", "disabled"),
+        ("--adapt-beam-lambda", "0"),
+        ("--phase1-prune-enabled",),
+    ],
+)
+def test_historical_beam_profile_fails_closed_on_drift(
+    override: tuple[str, ...],
+) -> None:
+    with pytest.raises(SystemExit):
+        _beam_args(*override)
+
+
+def test_main_profile_remains_effective_1x1_and_archive_disabled() -> None:
+    main = CANONICAL_SR_SNAKE_NO_PRUNE_SYMMETRIC_COST_V1_EXECUTION_SETTINGS
+    assert main["adapt_beam_live_branches"] == 1
+    assert main["adapt_beam_children_per_parent"] == 1
+    assert main["adapt_beam_terminated_keep"] == 0
+    assert main["adapt_beam_terminal_archive_mode"] == "disabled"
