+def _restored_estimator_prefix_checkpoint_state(
+    ledger: EstimatorCallLedger,
+    *,
+    prior_receipts: Sequence[Mapping[str, Any]] | None,
+    source_outer_iteration: int,
+) -> tuple[dict[str, Any], list[dict[str, Any]]]:
+    """Restore receipt deltas without restarting cumulative accounting at zero.
+
+    Modern result artifacts carry every prefix receipt and are preserved after
+    strict reconciliation.  Older authenticated checkpoints may carry only the
+    cumulative ledger.  For those, one explicit synthetic prefix receipt
+    represents the whole restored segment so later per-round deltas and the
+    terminal closure remain exact rather than double counting the prefix.
+    """
+
+    components = ("N_H_outer", "N_H_refit", "N_grad", "N_metric")
+    unique_summary = ledger.summary()
+    occurrence_summary = ledger.occurrence_summary()
+    unique_components = {
+        component: int(unique_summary.get(component, 0))
+        for component in components
+    }
+    occurrence_components = {
+        component: int(occurrence_summary.get(component, 0))
+        for component in components
+    }
+    unique_total = int(unique_summary.get("unique_primitive_count", 0))
+    raw_total = int(occurrence_summary.get("total_call_occurrences", 0))
+    preserved = [
+        copy.deepcopy(dict(receipt))
+        for receipt in list(prior_receipts or ())
+        if isinstance(receipt, Mapping)
+    ]
+    if prior_receipts is not None and len(preserved) != len(prior_receipts):
+        raise ValueError(
+            "Restored estimator prefix receipts must all be mappings."
+        )
+
+    if preserved:
+        enabled = [
+            receipt
+            for receipt in preserved
+            if bool(receipt.get("enabled", False))
+        ]
+        if not enabled:
+            raise ValueError(
+                "Restored estimator prefix receipts contain no enabled receipt."
+            )
+        sequences = [
+            int(receipt.get("checkpoint_sequence", -1))
+            for receipt in enabled
+        ]
+        if sequences != list(range(1, len(sequences) + 1)):
+            raise ValueError(
+                "Restored estimator prefix receipt sequences are not contiguous."
+            )
+        summed_raw_components = {
+            component: sum(
+                int(
+                    dict(receipt.get("raw_occurrence_delta", {}))
+                    .get("components", {})
+                    .get(component, 0)
+                )
+                for receipt in enabled
+            )
+            for component in components
+        }
+        summed_unique_components = {
+            component: sum(
+                int(
+                    dict(receipt.get("unique_primitive_delta", {}))
+                    .get("components", {})
+                    .get(component, 0)
+                )
+                for receipt in enabled
+            )
+            for component in components
+        }
+        last = enabled[-1]
+        last_raw = dict(last.get("cumulative_raw_occurrences", {}))
+        last_unique = dict(last.get("cumulative_unique_primitives", {}))
+        if (
+            summed_raw_components != occurrence_components
+            or summed_unique_components != unique_components
+            or int(last_raw.get("total", -1)) != raw_total
+            or int(last_unique.get("S_alg", -1)) != unique_total
+        ):
+            raise ValueError(
+                "Restored estimator prefix receipts do not reconcile with "
+                "the authenticated cumulative ledger."
+            )
+        checkpoint_sequence = int(sequences[-1])
+    else:
+        checkpoint_sequence = 1
+        preserved = [
+            {
+                "schema": "paper_i_active_prefix_estimator_ledger_receipt_v1",
+                "enabled": True,
+                "status": "complete",
+                "checkpoint_sequence": 1,
+                "occurrence_sequence_start_exclusive": 0,
+                "occurrence_sequence_end_inclusive": int(raw_total),
+                "raw_occurrence_delta": {
+                    "components": dict(occurrence_components),
+                    "total": int(raw_total),
+                },
+                "unique_primitive_delta": {
+                    "components": dict(unique_components),
+                    "S_alg": int(unique_total),
+                },
+                "cumulative_raw_occurrences": {
+                    "components": dict(occurrence_components),
+                    "total": int(raw_total),
+                },
+                "cumulative_unique_primitives": {
+                    "components": dict(unique_components),
+                    "S_alg": int(unique_total),
+                },
+                "outer_iteration": int(source_outer_iteration),
+                "checkpoint_kind": (
+                    "restored_authenticated_completed_round_prefix"
+                ),
+                "branch_id": None,
+                "parent_branch_id": None,
+                "canonical_same_state_deduplication_active": True,
+                "raw_occurrences_preserved": True,
+                "restored_prefix_compaction": True,
+            }
+        ]
+
+    cursor = {
+        "checkpoint_sequence": int(checkpoint_sequence),
+        "raw_occurrence_count": int(raw_total),
+        "unique_primitive_count": int(unique_total),
+        "unique_components": dict(unique_components),
+        "occurrence_components": dict(occurrence_components),
+    }
+    return cursor, preserved
+
