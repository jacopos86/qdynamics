+def _phase3_batch_appendix_trust_update_inputs(
+    selector_summary_raw: Mapping[str, Any] | None,
+    *,
+    pre_parameter_count: int,
+    selected_count: int,
+    selected_labels: Sequence[str],
+    radius: float,
+) -> tuple[dict[str, Any], str, bool, bool]:
+    """Validate the complete Phase-III batch response used by adaptive trust.
+
+    The appendix profile is intentionally distinct from the historical
+    singleton route.  Its trust update must consume the same full
+    active-plus-batch response model that selected the batch; it may not fall
+    back to the first selected singleton's feature row.
+    """
+
+    if not isinstance(selector_summary_raw, Mapping):
+        raise RuntimeError(
+            "Phase-III batching appendix trust update is missing its full "
+            "active-plus-batch response summary."
+        )
+    summary = dict(selector_summary_raw)
+    active_count = int(pre_parameter_count)
+    batch_count = int(selected_count)
+    if active_count < 0 or batch_count < 1:
+        raise RuntimeError(
+            "Phase-III batching appendix trust update received invalid "
+            "coordinate counts."
+        )
+    if not bool(summary.get("feasible", False)):
+        raise RuntimeError(
+            "Phase-III batching appendix trust update received an infeasible "
+            f"response summary: {summary.get('reason', 'unknown')!r}."
+        )
+    context_mode = str(summary.get("joint_batch_context_mode", ""))
+    if context_mode != BATCH_JOINT_CONTEXT_FULL_ANSATZ_V1:
+        raise RuntimeError(
+            "Phase-III batching appendix requires the full-ansatz joint "
+            "response context."
+        )
+    effective_policy = str(
+        summary.get("joint_linear_solve_policy_effective", "")
     )
+    if effective_policy != JOINT_LINEAR_SOLVE_SUPPORTED_METRIC_GLOBAL_TRUST_EIGH_V2:
+        raise RuntimeError(
+            "Phase-III batching appendix requires the supported-metric global "
+            "trust solve for its complete batch response."
+        )
+    if int(summary.get("selected_count", -1)) != batch_count:
+        raise RuntimeError(
+            "Phase-III batching appendix selected-count receipt disagrees "
+            "with the committed batch."
+        )
+    committed_labels = [str(value) for value in selected_labels]
+    modeled_labels = [
+        str(value) for value in summary.get("selected_labels", [])
+    ]
+    if (
+        len(committed_labels) != batch_count
+        or len(modeled_labels) != batch_count
+        or len(set(committed_labels)) != batch_count
+        or len(set(modeled_labels)) != batch_count
+        or set(committed_labels) != set(modeled_labels)
+    ):
+        raise RuntimeError(
+            "Phase-III batching appendix modeled and committed candidate "
+            "identities disagree."
+        )
+    batch_permutation = [
+        int(modeled_labels.index(label)) for label in committed_labels
+    ]
+    if batch_permutation != list(range(batch_count)):
+        # Finite-step admission ordering may permute an already selected batch.
+        # Apply the exact basis permutation to the complete response receipt so
+        # the adaptive-trust transaction remains expressed in commit order.
+        batch_perm = np.asarray(batch_permutation, dtype=int)
+        joint_perm = np.concatenate(
+            [np.arange(active_count, dtype=int), active_count + batch_perm]
+        )
 
+        def _permute_batch_vector(name: str) -> None:
+            value = np.asarray(summary.get(name, []), dtype=float)
+            if value.shape == (batch_count,):
+                summary[name] = value[batch_perm].tolist()
 
+        def _permute_joint_vector(name: str) -> None:
+            value = np.asarray(summary.get(name, []), dtype=float)
+            if value.shape == (active_count + batch_count,):
+                summary[name] = value[joint_perm].tolist()
+
+        def _permute_active_batch_matrix(name: str) -> None:
+            value = np.asarray(summary.get(name, []), dtype=float)
+            if value.shape == (active_count, batch_count):
+                summary[name] = value[:, batch_perm].tolist()
+
+        def _permute_batch_matrix(name: str) -> None:
+            value = np.asarray(summary.get(name, []), dtype=float)
+            if value.shape == (batch_count, batch_count):
+                summary[name] = value[np.ix_(batch_perm, batch_perm)].tolist()
+
+        def _permute_joint_matrix(name: str) -> None:
+            value = np.asarray(summary.get(name, []), dtype=float)
+            dimension = active_count + batch_count
+            if value.shape == (dimension, dimension):
+                summary[name] = value[np.ix_(joint_perm, joint_perm)].tolist()
+
+        for key in (
+            "g_B",
+            "batch_coordinate_step",
+            "natural_gradient_direction",
+            "g_effective_joint",
+        ):
+            _permute_batch_vector(key)
+        for key in ("joint_step", "g_effective_joint"):
+            _permute_joint_vector(key)
+        for key in ("G_AB_raw", "H_AB_raw"):
+            _permute_active_batch_matrix(key)
+        for key in ("G_BB_raw", "H_BB_raw", "M_effective"):
+            _permute_batch_matrix(key)
+        for key in ("M_joint_regularized",):
+            _permute_joint_matrix(key)
+        identities = list(summary.get("batch_coordinate_identities", []))
+        if len(identities) == batch_count:
+            summary["batch_coordinate_identities"] = [
+                copy.deepcopy(identities[index])
+                for index in batch_permutation
+            ]
+        summary["selected_labels"] = list(committed_labels)
+        summary["commit_order_basis_permutation"] = [
+            int(value) for value in batch_permutation
+        ]
+
+    def _finite_vector(name: str, expected_size: int) -> np.ndarray:
+        value = np.asarray(summary.get(name, []), dtype=float)
+        if value.shape != (int(expected_size),) or not np.all(np.isfinite(value)):
+            raise RuntimeError(
+                "Phase-III batching appendix response receipt has malformed "
+                f"{name}: expected shape {(int(expected_size),)!r}, got "
+                f"{value.shape!r}."
+            )
+        return value
+
+    def _finite_matrix(name: str, expected_shape: tuple[int, int]) -> np.ndarray:
+        value = np.asarray(summary.get(name, []), dtype=float)
+        if value.shape != expected_shape or not np.all(np.isfinite(value)):
+            raise RuntimeError(
+                "Phase-III batching appendix response receipt has malformed "
+                f"{name}: expected shape {expected_shape!r}, got "
+                f"{value.shape!r}."
+            )
+        return value
+
+    _finite_vector("g_A", active_count)
+    _finite_vector("g_B", batch_count)
+    _finite_vector("active_parameter_relaxation", active_count)
+    _finite_vector("batch_coordinate_step", batch_count)
+    _finite_matrix("G_AA_raw", (active_count, active_count))
+    _finite_matrix("G_AB_raw", (active_count, batch_count))
+    _finite_matrix("G_BB_raw", (batch_count, batch_count))
+    _finite_matrix("H_AA_raw", (active_count, active_count))
+    _finite_matrix("H_AB_raw", (active_count, batch_count))
+    _finite_matrix("H_BB_raw", (batch_count, batch_count))
+
+    active_identities = summary.get("active_coordinate_identities", [])
+    batch_identities = summary.get("batch_coordinate_identities", [])
+    if not (
+        isinstance(active_identities, Sequence)
+        and not isinstance(active_identities, (str, bytes))
+        and len(active_identities) == active_count
+        and isinstance(batch_identities, Sequence)
+        and not isinstance(batch_identities, (str, bytes))
+        and len(batch_identities) == batch_count
+    ):
+        raise RuntimeError(
+            "Phase-III batching appendix response-coordinate identities do "
+            "not cover the complete active ansatz plus committed batch."
+        )
+    if int(summary.get("required_batch_metric_rank_increment", -1)) != batch_count:
+        raise RuntimeError(
+            "Phase-III batching appendix rank receipt does not require one "
+            "supported direction per committed candidate."
+        )
+    if int(summary.get("batch_metric_rank_increment", -1)) < batch_count:
+        raise RuntimeError(
+            "Phase-III batching appendix committed a Gram-null batch direction."
+        )
+    displacement_sq = float(
+        summary.get("joint_fubini_study_displacement_sq", float("nan"))
+    )
+    predicted_reduction = float(
+        summary.get("applied_predicted_reduction", float("nan"))
+    )
+    trust_radius_sq = float(summary.get("trust_radius_sq", float("nan")))
+    expected_radius_sq = float(radius) ** 2
+    if not (
+        math.isfinite(displacement_sq)
+        and displacement_sq >= 0.0
+        and math.isfinite(predicted_reduction)
+        and predicted_reduction >= 0.0
+        and math.isfinite(trust_radius_sq)
+        and math.isclose(
+            trust_radius_sq,
+            expected_radius_sq,
+            rel_tol=1.0e-10,
+            abs_tol=max(1.0e-14, expected_radius_sq * 1.0e-10),
+        )
+    ):
+        raise RuntimeError(
+            "Phase-III batching appendix trust/displacement receipt is "
+            "missing, nonfinite, or inconsistent with the round radius."
+        )
+    return summary, context_mode, False, False
+
