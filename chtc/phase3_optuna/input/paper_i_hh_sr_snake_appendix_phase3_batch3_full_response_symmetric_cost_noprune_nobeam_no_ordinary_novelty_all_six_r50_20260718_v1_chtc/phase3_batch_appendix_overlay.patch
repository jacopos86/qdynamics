+from __future__ import annotations
+
+import copy
+from pathlib import Path
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(REPO_ROOT))
+
+from pipelines.static_adapt.adapt_pipeline import (
+    _phase3_batch_appendix_trust_update_inputs,
+)
+from pipelines.static_adapt.cli_config import (
+    _build_adapt_arg_parser,
+    _build_run_hardcoded_adapt_vqe_kwargs,
+)
+from pipelines.static_adapt.sr_snake_route_profile import (
+    CANONICAL_SR_SNAKE_NO_PRUNE_SYMMETRIC_COST_PHASE3_BATCH_V1_EXECUTION_SETTINGS,
+    SR_ROUTE_PROFILE_NO_PRUNE_SYMMETRIC_COST_PHASE3_BATCH_V1,
+    canonical_sr_snake_no_prune_symmetric_cost_phase3_batch_v1_contract,
+    canonical_sr_snake_no_prune_symmetric_cost_phase3_batch_v1_contract_sha256,
+    canonical_sr_snake_no_prune_symmetric_cost_v1_contract_sha256,
+)
+
+
+def _parser():
+    return _build_adapt_arg_parser(adapt_gradient_parity_rtol=1.0e-7)
+
+
+def _args(*extra: str):
+    return _parser().parse_args(
+        [
+            "--sr-route-profile",
+            "sr_snake_no_prune_symmetric_cost_phase3_batch_v1",
+            "--adapt-max-depth",
+            "50",
+            *extra,
+        ]
+    )
+
+
+def _runtime_kwargs(args) -> dict[str, object]:
+    return _build_run_hardcoded_adapt_vqe_kwargs(
+        args,
+        h_poly=None,
+        resolved_problem_context=SimpleNamespace(
+            layout=SimpleNamespace(total_qubits=6)
+        ),
+        cli_adapt_continuation_mode="phase3_v1",
+        adapt_ref_base_depth=0,
+        psi_ref_override=None,
+        psi_ref_source=None,
+        psi_ref_handoff_state_kind=None,
+        exact_gs_override=0.0,
+        phase3_oracle_gradient_config=None,
+        final_noise_audit_config=None,
+    )
+
+
+def _valid_batch_summary() -> dict[str, object]:
+    return {
+        "feasible": True,
+        "reason": "supported_metric_whitened_full_joint_model_v1",
+        "joint_batch_context_mode": "full_ansatz_v1",
+        "joint_linear_solve_policy_effective": (
+            "supported_metric_global_trust_eigh_v2"
+        ),
+        "selected_count": 2,
+        "selected_labels": ["b", "a"],
+        "active_coordinate_identities": ["old0", "old1"],
+        "batch_coordinate_identities": [
+            {"candidate_label": "b"},
+            {"candidate_label": "a"},
+        ],
+        "G_AA_raw": [[1.0, 0.0], [0.0, 1.0]],
+        "G_AB_raw": [[0.1, 0.2], [0.3, 0.4]],
+        "G_BB_raw": [[1.0, 0.1], [0.1, 1.0]],
+        "H_AA_raw": [[2.0, 0.0], [0.0, 2.0]],
+        "H_AB_raw": [[0.5, 0.6], [0.7, 0.8]],
+        "H_BB_raw": [[3.0, 0.2], [0.2, 4.0]],
+        "g_A": [0.1, 0.2],
+        "g_B": [0.3, 0.4],
+        "active_parameter_relaxation": [0.01, 0.02],
+        "batch_coordinate_step": [0.2, 0.1],
+        "joint_step": [0.01, 0.02, 0.2, 0.1],
+        "joint_fubini_study_displacement_sq": 0.1,
+        "applied_predicted_reduction": 0.2,
+        "trust_radius_sq": 0.25,
+        "required_batch_metric_rank_increment": 2,
+        "batch_metric_rank_increment": 2,
+    }
+
+
+def test_phase3_batch_appendix_profile_materializes_independent_scope() -> None:
+    args = _args()
+
+    assert args.sr_route_profile_resolved == (
+        SR_ROUTE_PROFILE_NO_PRUNE_SYMMETRIC_COST_PHASE3_BATCH_V1
+    )
+    assert args.sr_route_profile_contract == (
+        canonical_sr_snake_no_prune_symmetric_cost_phase3_batch_v1_contract()
+    )
+    assert args.sr_route_profile_contract_sha256 == (
+        canonical_sr_snake_no_prune_symmetric_cost_phase3_batch_v1_contract_sha256()
+    )
+    assert args.phase2_enable_batching is False
+    assert args.phase3_enable_batching is True
+    assert args.phase2_batch_selection_mode == "combinatorial_reduced_plane"
+    assert args.phase3_batch_selection_mode == "combinatorial_reduced_plane"
+    assert args.phase2_batch_target_size == 3
+    assert args.phase3_batch_target_size == 3
+    assert args.phase2_batch_size_cap == 3
+    assert args.phase3_batch_size_cap == 3
+    assert args.phase3_runtime_split_max_subset_size == 1
+    assert args.phase1_prune_enabled is False
+    assert args.adapt_beam_live_branches == 1
+    assert canonical_sr_snake_no_prune_symmetric_cost_phase3_batch_v1_contract_sha256() != (
+        canonical_sr_snake_no_prune_symmetric_cost_v1_contract_sha256()
+    )
+
+    kwargs = _runtime_kwargs(args)
+    assert kwargs["phase2_enable_batching"] is False
+    assert kwargs["phase3_enable_batching"] is True
+    assert kwargs["phase2_batch_selection_mode"] == (
+        "combinatorial_reduced_plane"
+    )
+    assert kwargs["phase3_batch_selection_mode"] == (
+        "combinatorial_reduced_plane"
+    )
+    assert kwargs["phase2_batch_target_size"] == 3
+    assert kwargs["phase2_batch_size_cap"] == 3
+
+
+@pytest.mark.parametrize(
+    "override",
+    [
+        ("--phase2-enable-batching",),
+        ("--phase3-no-batching",),
+        ("--phase2-batch-target-size", "2"),
+        ("--phase3-batch-size-cap", "2"),
+        ("--phase3-batch-selection-mode", "reduced_plane"),
+    ],
+)
+def test_phase3_batch_appendix_profile_rejects_scope_drift(
+    override: tuple[str, ...],
+) -> None:
+    with pytest.raises(SystemExit, match="2"):
+        _args(*override)
+
+
+def test_phase3_batch_appendix_contract_is_exact_one_factor_delta() -> None:
+    contract = canonical_sr_snake_no_prune_symmetric_cost_phase3_batch_v1_contract()
+    settings = contract["execution_settings"]
+    assert settings == (
+        CANONICAL_SR_SNAKE_NO_PRUNE_SYMMETRIC_COST_PHASE3_BATCH_V1_EXECUTION_SETTINGS
+    )
+    invariants = contract["semantic_invariants"]
+    assert invariants["phase2_batching_active"] is False
+    assert invariants["phase3_batching_active"] is True
+    assert invariants["phase3_batching_scope"] == (
+        "post_shortlist_admission_only_v1"
+    )
+    assert invariants["phase3_batch_response_scope"] == (
+        "full_active_plus_batch_v1"
+    )
+    assert invariants["phase3_batch_supported_fs_trust_receipt_required"] is True
+    assert invariants["phase3_batch_full_accepted_refit_required"] is True
+
+
+def test_phase3_batch_appendix_trust_receipt_covers_and_reorders_full_model() -> None:
+    summary, context, allow_historical, geometry_expansion = (
+        _phase3_batch_appendix_trust_update_inputs(
+            _valid_batch_summary(),
+            pre_parameter_count=2,
+            selected_count=2,
+            selected_labels=["a", "b"],
+            radius=0.5,
+        )
+    )
+
+    assert context == "full_ansatz_v1"
+    assert allow_historical is False
+    assert geometry_expansion is False
+    assert summary["selected_labels"] == ["a", "b"]
+    assert summary["commit_order_basis_permutation"] == [1, 0]
+    assert summary["g_B"] == [0.4, 0.3]
+    assert summary["batch_coordinate_step"] == [0.1, 0.2]
+    assert summary["G_AB_raw"] == [[0.2, 0.1], [0.4, 0.3]]
+    assert summary["G_BB_raw"] == [[1.0, 0.1], [0.1, 1.0]]
+
+
+@pytest.mark.parametrize(
+    ("mutation", "message"),
+    [
+        ({"joint_batch_context_mode": "local_window_v1"}, "full-ansatz"),
+        ({"joint_linear_solve_policy_effective": "scalar_v1"}, "global trust"),
+        ({"required_batch_metric_rank_increment": 1}, "rank receipt"),
+        ({"batch_metric_rank_increment": 1}, "Gram-null"),
+        ({"trust_radius_sq": 1.0}, "inconsistent"),
+        ({"H_AB_raw": [[0.1], [0.2]]}, "malformed H_AB_raw"),
+    ],
+)
+def test_phase3_batch_appendix_trust_receipt_fails_closed(
+    mutation: dict[str, object],
+    message: str,
+) -> None:
+    summary = copy.deepcopy(_valid_batch_summary())
+    summary.update(mutation)
+    with pytest.raises(RuntimeError, match=message):
+        _phase3_batch_appendix_trust_update_inputs(
+            summary,
+            pre_parameter_count=2,
+            selected_count=2,
+            selected_labels=["a", "b"],
+            radius=0.5,
+        )
