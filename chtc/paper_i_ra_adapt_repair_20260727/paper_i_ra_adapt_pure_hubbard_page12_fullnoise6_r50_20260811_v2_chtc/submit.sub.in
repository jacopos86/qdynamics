# Inert template only. Activation must render paths and add sealed authorities.
universe = vanilla
executable = __PACKAGE_REL__/execute_authorized_job.sh
transfer_executable = True

arguments = __PACKAGE_REL__ __PACKAGE_REL__/$(job_path) __ACTIVATION_REL__/authorizations/$(execution_id).json __PACKAGE_REL__/source/source_locked.tar.gz __SOURCE_ARCHIVE_SHA256__ chtc/phase3_optuna/image.sif fa5c4ea89a19ad2fa4c264f3bce65d9e83b86b91618ed97dfc80ee7be401239f $(execution_id) transfer/$(execution_id)__$(ClusterId)__$(ProcId).tar.gz $(job_sha256) __PACKAGE_MANIFEST_FILE_SHA256__ __JOB_WRAPPER_SHA256__ __RUN_CELL_SHA256__ __PACKAGE_CONTRACT_SHA256__

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
preserve_relative_paths = True
transfer_input_files = __PACKAGE_REL__, __ACTIVATION_REL__, chtc/phase3_optuna/image.sif
transfer_output_files = transfer/$(execution_id)__$(ClusterId)__$(ProcId).tar.gz
transfer_output_remaps = "transfer/$(execution_id)__$(ClusterId)__$(ProcId).tar.gz=/staging/jsstrobel/paper_i_ra_adapt_pure_hubbard_page12_fullnoise6_r50_20260811_v2/$(execution_id)__$(ClusterId)__$(ProcId).tar.gz"

request_cpus = $(request_cpus)
request_memory = $(memory_mb)MB
request_disk = $(disk_mb)MB
+MaxRuntime = $(max_runtime_seconds)

notification = Never
+JobBatchName = "paper-i-pure-hubbard-page12-fullnoise6-r50-20260811-v2"
getenv = False
stream_output = False
stream_error = False
on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)
periodic_release = False
leave_in_queue = False

log = __ACTIVATION_REL__/logs/$(Cluster).$(Process)-$(execution_id).log
output = __ACTIVATION_REL__/logs/$(Cluster).$(Process)-$(execution_id).out
error = __ACTIVATION_REL__/logs/$(Cluster).$(Process)-$(execution_id).err

queue execution_id, job_path, protocol_path, job_sha256, request_cpus, memory_mb, disk_mb, max_runtime_seconds from __PACKAGE_REL__/queue.tsv
