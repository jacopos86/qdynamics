# Paper-I historical-average RA singleton plateau r100 ordinary activation.
universe = vanilla
executable = /bin/bash
transfer_executable = False

arguments = @@ACTIVATION_REL@@/execute_authorized_job.sh @@ACTIVATION_REL@@ @@PACKAGE_REL@@ $(job_path) $(job_file_sha256) $(authorization_path) $(authorization_file_sha256) @@PACKAGE_REL@@/source/source_locked.tar.gz @@SOURCE_ARCHIVE_SHA256@@ @@IMAGE_PATH@@ @@IMAGE_SHA256@@ transfer/$(execution_id)__$(ClusterId)__$(ProcId).tar.gz

should_transfer_files = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
preserve_relative_paths = True
transfer_input_files = @@PACKAGE_REL@@, @@ACTIVATION_REL@@, @@IMAGE_PATH@@
output_destination = osdf:///chtc/staging/j/jsstrobel/paper_i_ra_historical_average_singleton_plateau6_r100_20260808_v1/outputs/

request_cpus = $(cpus)
request_memory = $(memory_mb)MB
request_disk = $(disk_mb)MB
+MaxRuntime = $(max_runtime_seconds)
requirements = (TARGET.HasSIF == true) && (TARGET.HasCHTCStaging == true)

notification = Never
getenv = False
stream_output = False
stream_error = False
+JobBatchName = "@@BATCH_NAME@@"
on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)
periodic_release = False
leave_in_queue = False

log = @@RUNTIME_REL@@/logs/$(Cluster).$(Process)__$(execution_id).log
output = @@RUNTIME_REL@@/logs/$(Cluster).$(Process)__$(execution_id).out
error = @@RUNTIME_REL@@/logs/$(Cluster).$(Process)__$(execution_id).err

queue execution_id,job_path,job_file_sha256,authorization_path,authorization_file_sha256,cpus,memory_mb,disk_mb,max_runtime_seconds from @@ACTIVATION_REL@@/queue.tsv

