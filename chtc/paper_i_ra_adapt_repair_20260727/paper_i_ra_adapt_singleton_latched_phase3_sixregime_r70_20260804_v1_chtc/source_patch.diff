+def _ra_post_latch_insertion_round_policy(
+    *,
+    history: Sequence[Mapping[str, Any]],
+    raw_round_policy: Mapping[str, Any],
+) -> dict[str, Any]:
+    """Gate the unchanged plateau statistic behind a prior full Phase III."""
+
+    from pipelines.static_adapt.ra_adapt.contracts import (
+        RA_ADAPT_POST_LATCH_INSERTION_TRIGGER_SCOPE,
+    )
+
+    state = _ra_latched_phase3_history_state(history)
+    raw_open = bool(raw_round_policy.get("domain_open", False))
+    trigger_eligible = bool(
+        state["latched"] and state["last_round_live"] and history
+    )
+    domain_open = bool(trigger_eligible and raw_open)
+    receipt = copy.deepcopy(dict(raw_round_policy))
+    receipt.update(
+        {
+            "domain_state": "open" if domain_open else "closed",
+            "domain_open": domain_open,
+            "effective_insertion_mode": (
+                "full_commutation_reduced" if domain_open else "append_only"
+            ),
+            "raw_progress_plateau_domain_open": raw_open,
+            "insertion_trigger_scope": (
+                RA_ADAPT_POST_LATCH_INSERTION_TRIGGER_SCOPE
+            ),
+            "phase3_latched_before_round": bool(state["latched"]),
+            "preceding_full_phase3_transition_eligible": trigger_eligible,
+            "preceding_accepted_round": (
+                len(history) if trigger_eligible else None
+            ),
+            "insertion_latch_active": False,
+        }
+    )
+    return receipt
+
