+def _ra_latched_phase3_history_state(
+    history: Sequence[Mapping[str, Any]],
+) -> dict[str, Any]:
+    """Reconstruct the monotone Phase-III latch from accepted receipts."""
 
+    from pipelines.static_adapt.ra_adapt.contracts import (
+        RA_ADAPT_PHASE3_POPULATION_LATCHED_ON_PROGRESS_PLATEAU,
+    )
 
+    latched = False
+    first_open_round: int | None = None
+    last_round_live = False
+    for ordinal, row in enumerate(history, start=1):
+        activation = row.get("phase3_population_activation")
+        if (
+            not isinstance(activation, Mapping)
+            or activation.get("schema")
+            != "ra_phase3_population_activation_receipt_v2"
+            or activation.get("policy")
+            != RA_ADAPT_PHASE3_POPULATION_LATCHED_ON_PROGRESS_PLATEAU
+        ):
+            raise RuntimeError(
+                "Latched Phase-III history lost its activation receipt."
+            )
+        entry_open = activation.get("entry_plateau_domain_open")
+        before = activation.get("phase3_latched_before_round")
+        after = activation.get("phase3_latched_after_round")
+        opened = activation.get("phase3_latch_opened_this_round")
+        competitive_live = activation.get("competitive_population_live")
+        if not all(
+            isinstance(value, bool)
+            for value in (
+                entry_open,
+                before,
+                after,
+                opened,
+                competitive_live,
+            )
+        ):
+            raise RuntimeError(
+                "Latched Phase-III history carries a non-Boolean state."
+            )
+        expected_after = bool(latched or entry_open)
+        expected_opened = bool(not latched and entry_open)
+        if (
+            before is not latched
+            or after is not expected_after
+            or opened is not expected_opened
+            or competitive_live is not expected_after
+            or activation.get("independent_latch_active") is not True
+            or activation.get("deactivation_allowed") is not False
+            or activation.get("hysteresis_active") is not False
+        ):
+            raise RuntimeError(
+                "Latched Phase-III history is not a monotone first-open latch."
+            )
+        if expected_opened:
+            if first_open_round is not None:
+                raise RuntimeError("Phase III latched open more than once.")
+            first_open_round = ordinal
+        if activation.get("first_latch_accepted_round") != first_open_round:
+            raise RuntimeError(
+                "Latched Phase-III history changed its first-open round."
+            )
+        latched = expected_after
+        last_round_live = bool(competitive_live)
+    return {
+        "latched": bool(latched),
+        "first_open_round": first_open_round,
+        "last_round_live": bool(last_round_live),
+    }
+
