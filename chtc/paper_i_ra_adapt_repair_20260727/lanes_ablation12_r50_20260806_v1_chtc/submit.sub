# Lanes-off ablation, 12 cells, horizon 50. Per-cell authorization overlay
# ships under authority/ and is bound to each job digest.
universe = vanilla
executable = execute_source_locked_job.sh
arguments = $(execution_id).json $(execution_id).auth.json result.json
transfer_executable = true
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = run_cell.py,package_contract.py,source_locked.tar.gz,source_archive_manifest.json,jobs/$(execution_id).json,authority/$(execution_id).auth.json
transfer_output_files = result.json
request_cpus = $(cpus)
request_memory = $(mem_mb)MB
request_disk = $(disk_mb)MB
+MaxRuntime = $(runtime_s)
log = logs/$(execution_id).log
output = logs/$(execution_id).out
error = logs/$(execution_id).err
queue execution_id,cpus,mem_mb,disk_mb,runtime_s from queue.tsv
