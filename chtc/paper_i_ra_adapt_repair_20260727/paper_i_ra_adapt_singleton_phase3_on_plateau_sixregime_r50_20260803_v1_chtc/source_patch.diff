+def _ra_phase3_population_activation_receipt(
+    *,
+    route_contract: Mapping[str, Any],
+    insertion_round_policy: Mapping[str, Any] | None,
+    candidate_adapter: Any | None,
+    admission_policy: Any,
+) -> dict[str, Any]:
+    """Resolve the singleton ablation from the already-authenticated trigger.
 
+    The plateau predicate is computed once by ``prepare_selection``.  This
+    projection deliberately has no memory, patience counter, or hysteresis of
+    its own.  A closed round fixes admission to the top Phase-II record, then
+    materializes only that winner's response geometry for the unchanged
+    accepted-refit transaction.
+    """
 
+    from pipelines.static_adapt.ra_adapt.adapters import (
+        SINGLE_PAULI_ADAPTER_ID,
+    )
+    from pipelines.static_adapt.ra_adapt.contracts import (
+        CANDIDATE_REPRESENTATION_SINGLE_PAULI,
+        RA_ADAPT_PHASE3_POPULATION_ALL_ROUNDS,
+        RA_ADAPT_PHASE3_POPULATION_ON_INSERTION_PLATEAU,
+        RA_ADAPT_PHASE3_PREPLATEAU_WINNER_MATERIALIZATION,
+    )
+
+    execution = route_contract.get("execution_settings")
+    invariants = route_contract.get("semantic_invariants")
+    if not isinstance(execution, Mapping) or not isinstance(
+        invariants, Mapping
+    ):
+        raise RuntimeError(
+            "RA Phase-III activation requires a complete route contract."
+        )
+    activation_policy = str(
+        execution.get(
+            "ra_phase3_population_activation_policy",
+            RA_ADAPT_PHASE3_POPULATION_ALL_ROUNDS,
+        )
+    )
+    if activation_policy == RA_ADAPT_PHASE3_POPULATION_ALL_ROUNDS:
+        return {
+            "schema": "ra_phase3_population_activation_receipt_v1",
+            "policy": RA_ADAPT_PHASE3_POPULATION_ALL_ROUNDS,
+            "competitive_population_live": True,
+            "activation_source": "route_default_all_rounds_v1",
+            "preplateau_admission_authority": None,
+            "winner_materialization_policy": None,
+            "insertion_plateau_domain_open": None,
+            "independent_latch_active": False,
+            "hysteresis_active": False,
+        }
+    if activation_policy != (
+        RA_ADAPT_PHASE3_POPULATION_ON_INSERTION_PLATEAU
+    ):
+        raise RuntimeError(
+            "RA route declared an unknown Phase-III population activation "
+            f"policy: {activation_policy!r}."
+        )
+    expected_materialization = (
+        RA_ADAPT_PHASE3_PREPLATEAU_WINNER_MATERIALIZATION
+    )
+    if (
+        not isinstance(admission_policy, SingletonAdmission)
+        or str(getattr(candidate_adapter, "adapter_id", ""))
+        != SINGLE_PAULI_ADAPTER_ID
+        or invariants.get("candidate_representation")
+        != CANDIDATE_REPRESENTATION_SINGLE_PAULI
+        or execution.get("adapt_insertion_mode")
+        != "insertion_commutation_plateau_v2"
+        or execution.get("ra_phase3_preplateau_materialization_policy")
+        != expected_materialization
+        or invariants.get("phase3_activation_source")
+        != "same_round_authenticated_insertion_plateau_domain_open_v1"
+        or invariants.get("phase3_activation_independent_latch") is not False
+        or invariants.get("phase3_activation_hysteresis_active") is not False
+        or not isinstance(insertion_round_policy, Mapping)
+        or insertion_round_policy.get("policy")
+        != "insertion_commutation_plateau_v2"
+        or insertion_round_policy.get("patience") != 1
+        or insertion_round_policy.get("hysteresis_active") is not False
+    ):
+        raise RuntimeError(
+            "The singleton Phase-III-on-plateau activation contract drifted."
+        )
+    domain_open = bool(insertion_round_policy.get("domain_open", False))
+    return {
+        "schema": "ra_phase3_population_activation_receipt_v1",
+        "policy": RA_ADAPT_PHASE3_POPULATION_ON_INSERTION_PLATEAU,
+        "competitive_population_live": domain_open,
+        "activation_source": (
+            "same_round_authenticated_insertion_plateau_domain_open_v1"
+        ),
+        "preplateau_admission_authority": (
+            None if domain_open else "phase2_raw_score_top_rank_v1"
+        ),
+        "winner_materialization_policy": (
+            None if domain_open else expected_materialization
+        ),
+        "insertion_plateau_domain_open": domain_open,
+        "independent_latch_active": False,
+        "hysteresis_active": False,
+    }
