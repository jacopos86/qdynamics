universe = vanilla
executable = __PACKAGE_REL__/execute_job.sh
transfer_executable = True

arguments = __PACKAGE_REL__ __PACKAGE_REL__/$(job_path) __PACKAGE_REL__/$(protocol_path) __PACKAGE_REL__/execution_authorization.json __PACKAGE_REL__/source/source_locked.tar.gz __SOURCE_SHA256__ chtc/phase3_optuna/image.sif fa5c4ea89a19ad2fa4c264f3bce65d9e83b86b91618ed97dfc80ee7be401239f $(execution_id) transfer/$(execution_id)__$(ClusterId)__$(ProcId).tar.gz

should_transfer_files = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
preserve_relative_paths = True
transfer_input_files = __PACKAGE_REL__, chtc/phase3_optuna/image.sif
transfer_output_files = transfer/$(execution_id)__$(ClusterId)__$(ProcId).tar.gz

request_cpus = $(request_cpus)
request_memory = $(memory_mb)MB
request_disk = $(disk_mb)MB
+MaxRuntime = $(max_runtime_seconds)

notification = Never
getenv = False
stream_output = False
stream_error = False
on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)
periodic_release = False
leave_in_queue = False

log = logs/$(Cluster).$(Process)-$(execution_id).log
output = logs/$(Cluster).$(Process)-$(execution_id).out
error = logs/$(Cluster).$(Process)-$(execution_id).err

queue execution_id, job_path, protocol_path, request_cpus, memory_mb, disk_mb, max_runtime_seconds from __PACKAGE_REL__/queue.tsv
