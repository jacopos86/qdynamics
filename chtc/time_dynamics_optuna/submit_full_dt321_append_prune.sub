requirements = TARGET.HasSIF
request_cpus = 1
request_disk = 30GB
request_memory = 12GB
+MaxRuntime = 43200
+JobBatchName = "holstein-td-optuna-dt321-full"
log = logs/td-optuna-dt321-full.$(Cluster).$(Process).log
output = logs/td-optuna-dt321-full.$(Cluster).$(Process).out
error = logs/td-optuna-dt321-full.$(Cluster).$(Process).err
queue record_id from chtc/time_dynamics_optuna/input/full_dt321_append_prune_records.txt
