universe = vanilla
executable = chtc/time_dynamics_optuna/run_task_apptainer.sh
arguments = $(record_id)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_executable = True
preserve_relative_paths = True
transfer_input_files = pipelines, src, docs, test_support, MATH/Math.md, run_guide.md, AGENTS.md, chtc/time_dynamics_optuna/image.sif, chtc/time_dynamics_optuna/run_task_apptainer.sh, chtc/time_dynamics_optuna/run_task.sh, chtc/time_dynamics_optuna/run_task.py, chtc/time_dynamics_optuna/input/records.tsv, chtc/time_dynamics_optuna/input/seed_artifacts/$(record_id).json
