# Paper-II all-algorithm class-calibration full diagnostic batch: candidate/diagnostic only.
# Not promoted, not paper-facing; queues the 160 checked-in candidate records.
universe = vanilla
executable = chtc/time_dynamics_optuna/run_task_apptainer.sh
arguments = $(record_id) chtc/time_dynamics_optuna/input/paper_ii_all_algorithm_class_calibration_v1_records.tsv
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_executable = True
preserve_relative_paths = True
transfer_input_files = pipelines, src, test_support, MATH/Math.md, run_guide.md, AGENTS.md, chtc/time_dynamics_optuna, chtc/generic_time_dynamics_table
transfer_output_files = raw_outputs, logs
log = logs/paper-ii-all-algorithm-class-calibration-v1.$(Cluster).$(Process).log
output = logs/paper-ii-all-algorithm-class-calibration-v1.$(Cluster).$(Process).out
error = logs/paper-ii-all-algorithm-class-calibration-v1.$(Cluster).$(Process).err
requirements = TARGET.HasSIF
request_cpus = 1
request_memory = 12GB
request_disk = 40GB
+MaxRuntime = 7200
+JobBatchName = "holstein-paper-ii-all-algo-class-cal-v1-full-diagnostic"
queue record_id from chtc/time_dynamics_optuna/input/paper_ii_all_algorithm_class_calibration_v1_record_ids.txt
