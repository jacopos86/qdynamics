universe = vanilla
executable = chtc/paper_ii_regime_seeds_v1/run_seed_apptainer.sh
arguments = $(regime_id)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_executable = True
preserve_relative_paths = True
transfer_input_files = pipelines, src, chtc/paper_ii_regime_seeds_v1, chtc/time_dynamics_optuna/image.sif
transfer_output_files = raw_outputs, logs
log = logs/paper-ii-regime-seeds.$(Cluster).$(Process).log
output = logs/paper-ii-regime-seeds.$(Cluster).$(Process).out
error = logs/paper-ii-regime-seeds.$(Cluster).$(Process).err
requirements = TARGET.HasSIF
request_cpus = 4
request_memory = 24GB
request_disk = 40GB
+MaxRuntime = 86400
+JobBatchName = "holstein-paper-ii-regime-seeds-v1"
queue regime_id from chtc/paper_ii_regime_seeds_v1/input/regime_ids.txt
