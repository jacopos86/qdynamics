universe = vanilla
executable = chtc/paper_ii_regime_seeds_v1/run_seed_apptainer.sh
arguments = $(regime_id)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_executable = True
preserve_relative_paths = True
transfer_input_files = pipelines, src, chtc/paper_ii_regime_seeds_v1, chtc/time_dynamics_optuna/image.sif
